rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // REGLA CORREGIDA: "empresa" a "empresas"
    // Esta regla ahora coincide con la ruta que usa tu código y protege
    // tanto los documentos de la empresa como sus subcolecciones (como 'metadata').
    match /empresas/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Regla para la colección de clientes
    match /clientes/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Regla para la colección de customers
    match /customers/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Regla para la colección de reportes
    match /reportes/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Regla para la colección de usuarios, es muy importante
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Regla para la actividad (si la usas en el futuro)
    match /actividad/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
