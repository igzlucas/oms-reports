rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regla para la colección de clientes
    match /clientes/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Regla para la colección de reportes
    match /reportes/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Regla para la colección de empresa
    match /empresa/{document=**} {
      allow read, write: if request.auth != null;
    }

    // ¡NUEVO! Regla para la colección de usuarios
    match /users/{userId} {
      // Permite a un usuario leer y escribir en su propio documento
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /actividad/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
