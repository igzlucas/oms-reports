rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Empresas: solo usuarios autenticados
    match /empresas/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Clientes: solo usuarios autenticados
    match /clientes/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Customers: solo usuarios autenticados
    match /customers/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Reportes: lectura pública si tiene token, escritura solo autenticado
    match /reportes/{reportId} {
      allow read: if resource.data.publicLinkToken != null;
      allow write: if request.auth != null;
    }

    // Usuarios: solo el propio usuario autenticado
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Actividad: solo usuarios autenticados
    match /actividad/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}